{{ 'repair-widget.css' | asset_url | stylesheet_tag }}

{% if section.settings.title != blank %}
  <h2 style="text-align:center;font-size:clamp(1.6rem,2.4vw,2.8rem);font-weight:900;color:#003b4a;margin:0 0 24px;letter-spacing:-.02em">
    {{ section.settings.title }}
  </h2>
{% endif %}

<div
  id="repair-widget-root"
  data-proxy-base="/apps/reparatie"
></div>

{{ 'repair-widget.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Reparatie Widget",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Reparatie aanvragen"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximale breedte (px)",
      "min": 400,
      "max": 1200,
      "step": 20,
      "default": 720
    }
  ]
}
{% endschema %}
